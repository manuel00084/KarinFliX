# ============================================
# KarinFLiX - Variables de entorno
# ============================================
# Copia este archivo a .env y reemplaza los valores
# NO commits este archivo con valores reales
# ============================================

# --- App ---
KARIN_APP_VERSION=1.4.0

# --- Android Signing (for build) ---
# No poner en .env para Android, usar gradle.properties local
# KARIN_STORE_PASSWORD=your_password
# KARIN_KEY_ALIAS=your_alias
# KARIN_KEY_PASSWORD=your_password

# --- Sentry (crash reporting) ---
# SENTRY_DSN=
