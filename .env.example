# ============================================
# KarinFLiX - Variables de entorno
# ============================================
# Copia este archivo a .env y reemplaza los valores
# NO commits este archivo con valores reales
# ============================================

# --- App ---
KARIN_APP_VERSION=1.4.0
KARIN_DEVICE_NAME=KARINFLiX Device
KARIN_USER_NAME=User
KARIN_DEVICE_TYPE=PC

# --- Network ---
KARIN_API_HOST=0.0.0.0
KARIN_API_PORT=7800
KARIN_BROADCAST_PORT=7801

# --- Security ---
# Genera un secreto seguro: python -c "import secrets; print(secrets.token_hex(32))"
KARIN_TOKEN_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
KARIN_TOKEN_EXPIRY=3600

# --- Database ---
KARIN_DB_PATH=karin_link.db

# --- Remote (future) ---
KARIN_REMOTE_ENABLED=false
KARIN_RELAY_SERVER=

# --- Android Signing (for build) ---
# No poner en .env para Android, usar gradle.properties local
# KARIN_STORE_PASSWORD=your_password
# KARIN_KEY_ALIAS=your_alias
# KARIN_KEY_PASSWORD=your_password

# --- Sentry (crash reporting) ---
# SENTRY_DSN=
