<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Video MotionX2 60fps: lo dibuja MotionX2GlesRenderer (GLES2 propio)
         sobre el Surface de este SurfaceView (ruta nativa de presentación). -->
    <SurfaceView
        android:id="@+id/motionx2_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Solo controles/OSD: sin superficie de video (surface_type="none"). -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/player_control_view"
        app:surface_type="none" />

</FrameLayout>
