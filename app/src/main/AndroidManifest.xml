<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Micrófono opcional: la búsqueda por voz lo usa si existe, pero las TV
         sin mic no deben filtrarse ni pedir un permiso imposible. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Solo lectura oportunista del códec BT activo para mostrarlo en el
         panel Audiophile; sin este permiso el códec queda "desconocido". -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- targetSdk 34 exige un tipo concreto para el servicio en primer plano
         que mantiene KARIN Link vivo (descubrimiento + proxy de video). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- KARIN Link descubre peers por mDNS. Sin esto, NsdManager falla en
         varios fabricantes (y en Android TV con ROMs cerradas). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Galería Karin: poner imagen como fondo de pantalla (permiso normal). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:name=".KarinTVApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KarinFLiX"
        android:banner="@drawable/banner"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize"
            android:theme="@style/Theme.KarinFLiX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.MainActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.SiteBrowserActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.SeriesDetailActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.SettingsActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.FileExplorerActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <!-- Gestor dual-pane con copiar/pegar (ExploreKF): se abre desde el
             botón "Gestor" del explorador de archivos. Sin orientación fija:
             en TV/tablet van las 2 columnas, en móvil angosto una con
             pestañas (ver applyPaneMode). -->
        <activity android:name=".ui.ExploreKF" android:exported="false"
            android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.CalendarActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.CreditsActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.TermsAndConditionsActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.TutorialActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.GlassesTutorialActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.GaleriaKarinActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.EmbedWebViewActivity" android:exported="true"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize"
            android:theme="@style/Theme.KarinFLiX"
            android:hardwareAccelerated="true" />

        <activity android:name=".ui.ErrorActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".ui.OnboardingActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".player.ExoPlayerActivity" android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.KarinFLiX" />

        <!-- El reproductor del sistema es un activity-alias: el toggle "Activar
             como Reproductor de Video" enciende/apaga si KarinFLiX aparece en el
             selector "Abrir con..." (Android). La activity sigue disponible para
             los lanzamientos internos con nombre explícito. -->
        <activity-alias
            android:name=".player.ExoPlayerVideoPlayer"
            android:exported="true"
            android:targetActivity=".player.ExoPlayerActivity"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity-alias>

        <activity android:name=".karinlink.KarinLinkActivity" android:exported="true"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".karinlink.KarinLinkConfigActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

    <activity android:name=".karinlink.RemoteControlActivity" android:exported="false"
        android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

    <activity android:name=".karinlink.KarinLinkQueueActivity" android:exported="false"
        android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <activity android:name=".karinlink.KarinLinkSendActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <!-- Emision DLNA/Cast: se abre desde el boton "Emitir" del reproductor. -->
        <activity android:name=".cast.KarinLinkCastActivity" android:exported="false"
            android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />

        <!-- Framework de Cast: el punto de entrada de la configuracion. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.karin.streamtv.cast.CastOptionsProvider" />

        <service android:name=".karinlink.KarinLinkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service android:name=".karinlink.KarinRemoteService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/remote_service_config" />
        </service>

        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider" android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
